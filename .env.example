# Copy to .env and fill locally. Never commit .env.
# Local SQLite database (default for development):
DATABASE_URL=sqlite:///chichas.db

# Or Supabase Postgres URI:
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require

# Staff Key for /owner/menu and /owner/orders dashboard
STAFF_API_KEY=chichas-staff-secret-2026

# Bolna Voice Webhook Auth Token
BOLNA_AUTH_TOKEN=chichas-bolna-secret-2026

# Set to true for off-hours development & testing
BYPASS_HOURS=true

# Meta WhatsApp Cloud API credentials
META_ACCESS_TOKEN=your_meta_system_user_access_token
META_PHONE_NUMBER_ID=your_meta_phone_number_id
GRAPH_API_VERSION=v21.0
