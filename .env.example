# Copy to .env and fill locally. Never commit .env.
# Supabase Dashboard > Connect > Session pooler (Postgres URI)
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
STAFF_API_KEY=REPLACE_WITH_RANDOM_SECRET
